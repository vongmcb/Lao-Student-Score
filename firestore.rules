rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default catch-all rule: Allow authenticated users to read and write
    // In Lao Student Score app, teachers and admin manage student data securely.
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
